<!DOCTYPE html>
<html lang="en">


<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    Exam Preparation | Cambridge Digital Catalogue
</title>

<link
    rel="stylesheet"
    href="css/catalogue.css"
>

<style>

/* ========================================
   HERO
======================================== */

.exam-hero{
    padding:48px 6% 36px;
    background:#fff;
}

.exam-hero-inner{
    max-width:1180px;
    margin:auto;
}

.back-link{
    display:inline-block;
    margin-bottom:20px;
    color:var(--navy);
    text-decoration:none;
    font-size:12px;
    font-weight:700;
}

.exam-hero h1{
    margin:0;
    font-size:clamp(32px,5vw,48px);
    letter-spacing:-1.3px;
}

.hero-description{
    max-width:680px;
    margin:12px 0 0;
    color:var(--muted);
    font-size:13px;
    line-height:1.6;
}


/* ========================================
   CONTROLS
======================================== */

.catalogue-controls{
    margin-top:28px;

    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        auto
        auto;

    gap:10px;
}

.catalogue-controls input,
.catalogue-controls select{

    width:100%;
    box-sizing:border-box;

    padding:13px 14px;

    border:1px solid var(--border);
    border-radius:8px;

    background:#fff;
    color:var(--text);

    font:inherit;
    font-size:12px;
}

.catalogue-controls input:focus,
.catalogue-controls select:focus{

    outline:2px solid var(--navy);
    outline-offset:1px;
}


/* ========================================
   SUMMARY
======================================== */

.results-summary{
    margin-bottom:20px;

    display:flex;
    justify-content:space-between;
    align-items:end;

    gap:20px;
}

.results-summary h2{
    margin:0;
    font-size:25px;
}

.results-count{
    margin:0;
    color:var(--muted);
    font-size:11px;
}


/* ========================================
   FAMILY
======================================== */

.family-section{
    display:grid;
    gap:14px;
}

.family-section + .family-section{
    margin-top:34px;
}

.family-heading{

    padding-bottom:10px;

    display:flex;
    justify-content:space-between;
    align-items:end;

    gap:20px;

    border-bottom:2px solid var(--navy);
}

.family-heading h3{
    margin:0;
    font-size:21px;
}

.family-heading span{
    color:var(--muted);
    font-size:10px;
}


/* ========================================
   SUBJECT GROUP
======================================== */

.subject-group{

    overflow:hidden;

    border:1px solid var(--border);

    border-radius:var(--radius);

    background:#fff;
}

.subject-header{

    padding:17px 22px;

    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:18px;

    border-bottom:1px solid var(--border);

    background:#fafbfc;
}

.subject-header h4{
    margin:0;
    font-size:16px;
}

.subject-header span{
    flex:0 0 auto;

    color:var(--muted);
    font-size:10px;
}


/* ========================================
   BOOK
======================================== */

.book-list{
    display:grid;
}

.exam-book{

    padding:18px 22px;

    display:grid;

    grid-template-columns:
        64px
        minmax(0,1fr)
        auto;

    gap:18px;

    align-items:center;

    border-bottom:1px solid var(--border);
}

.exam-book:last-child{
    border-bottom:0;
}

.cover-placeholder{

    width:64px;
    height:84px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:5px;

    background:#eef1f5;

    color:#8b95a5;

    font-size:8px;
    font-weight:750;

    text-align:center;
}

.book-details{
    min-width:0;
}

.book-details h5{
    margin:0 0 7px;

    font-size:14px;
    line-height:1.35;
}

.book-meta{

    display:flex;
    flex-wrap:wrap;

    gap:6px 12px;

    color:var(--muted);

    font-size:10px;
}

.book-action{

    padding:9px 12px;

    border:1px solid var(--navy);

    border-radius:6px;

    background:#fff;

    color:var(--navy);

    cursor:pointer;

    font-size:10px;
    font-weight:750;

    white-space:nowrap;

    touch-action:manipulation;
}

.book-action:hover{
    background:var(--navy);
    color:#fff;
}

.book-action:focus-visible{
    outline:2px solid var(--navy);
    outline-offset:2px;
}


/* ========================================
   EMPTY STATE
======================================== */

.message-state{

    padding:45px 24px;

    border:1px solid var(--border);

    border-radius:var(--radius);

    background:#fff;

    text-align:center;
}

.message-state h2{
    margin:0 0 9px;
    font-size:22px;
}

.message-state p{

    max-width:560px;

    margin:0 auto;

    color:var(--muted);

    font-size:12px;
    line-height:1.6;
}

.message-state a{

    display:inline-block;

    margin-top:18px;

    color:var(--navy);

    font-size:12px;
    font-weight:750;

    text-decoration:none;
}


/* ========================================
   MOBILE
======================================== */

@media(max-width:760px){

    .exam-hero{
        padding:36px 18px 30px;
    }

    .catalogue-controls{
        grid-template-columns:1fr;
    }

    .results-summary{
        flex-direction:column;
        align-items:start;
        gap:5px;
    }

    .family-heading{
        align-items:start;
    }

    .subject-header{
        padding:16px 18px;
    }

    .exam-book{

        padding:17px 18px;

        grid-template-columns:
            52px
            minmax(0,1fr);

        gap:14px;
    }

    .cover-placeholder{
        width:52px;
        height:70px;
    }

    .book-action{
        grid-column:2;
        justify-self:start;
    }

}

@media(hover:none){

    .book-action:hover{
        background:#fff;
        color:var(--navy);
    }

}

</style>

</head>


<body>


<header class="catalogue-header">

    <div class="brand">

        <div class="brand-name">
            CAMBRIDGE
        </div>

        <div class="brand-company">
            PUBLISHING COMPANY PVT. LTD.
        </div>

    </div>

    <div class="catalogue-year">
        DIGITAL CATALOGUE · 2026–27
    </div>

</header>


<section class="exam-hero">

    <div class="exam-hero-inner">

        <a
            href="school-education.html"
            class="back-link"
            id="backLink"
        >
            ← School Education
        </a>

        <p class="eyebrow">
            EXAM PREPARATION
        </p>

        <h1 id="pageHeading">
            Exam Preparation
        </h1>

        <p
            class="hero-description"
            id="pageDescription"
        >
            Browse Cambridge exam-preparation publications.
        </p>


        <div
            class="catalogue-controls"
            id="catalogueControls"
            hidden
        >

            <input
                type="search"
                id="bookSearch"
                placeholder="Search books, subjects or series..."
                autocomplete="off"
                aria-label="Search exam preparation books"
            >


            <select
                id="familyFilter"
                aria-label="Filter by product family"
            >

                <option value="">
                    All Product Families
                </option>

            </select>


            <select
                id="subjectFilter"
                aria-label="Filter by subject"
            >

                <option value="">
                    All Subjects
                </option>

            </select>

        </div>

    </div>

</section>


<main>

<section class="catalogue-section">

    <div id="messageContainer"></div>


    <div
        id="catalogueContent"
        hidden
    >

        <div class="results-summary">

            <h2>
                Publications
            </h2>

            <p
                class="results-count"
                id="resultsCount"
            ></p>

        </div>


        <div id="familyList"></div>

    </div>

</section>

</main>


<footer>

    <div>

        <strong>
            Cambridge Publishing Company Pvt. Ltd.
        </strong>

        <p>
            Bengaluru, Karnataka
        </p>

    </div>

    <p class="footer-note">
        Digital Catalogue · 2026–27
    </p>

</footer>


<script src="js/catalogue-data.js"></script>

<script>

/* ========================================
   DISPLAY ORDER
======================================== */

const FAMILY_ORDER = [

    "Honest Success Series",

    "LBA",

    "Internal Assessment",

    "Workbooks"

];


const SUBJECT_ORDER = [

    "English I Language",
    "English II Language",
    "English III Language",

    "Kannada I Language",
    "Kannada II Language",

    "Hindi III Language",

    "Mathematics",
    "Science",
    "Social Science",

    "Ganitha",
    "Vignana",
    "Samaja Vignana",

    "Combined"

];


/* ========================================
   STATE
======================================== */

let selectedClass = null;

let examBooks = [];


/* ========================================
   VALIDATION
======================================== */

function isValidExamClass(value){

    if(
        value === null ||
        value === undefined ||
        value === ""
    ){
        return false;
    }


    const number =
        Number(value);


    return (
        Number.isInteger(number) &&
        number >= 5 &&
        number <= 10
    );

}


/* ========================================
   SAFE CATALOGUE
======================================== */

function getCatalogue(){

    if(
        !Array.isArray(
            window.CAMBRIDGE_CATALOGUE
        )
    ){
        return [];
    }


    return window
        .CAMBRIDGE_CATALOGUE
        .filter(function(book){

            return (
                book &&
                typeof book === "object" &&
                book.active !== false
            );

        });

}


/* ========================================
   ORDER HELPERS
======================================== */

function orderIndex(
    value,
    order
){

    const index =
        order.indexOf(
            value
        );


    return (
        index === -1
            ? Number.MAX_SAFE_INTEGER
            : index
    );

}


/* ========================================
   MESSAGE
======================================== */

function showMessage(
    heading,
    text
){

    const container =
        document.getElementById(
            "messageContainer"
        );


    container.innerHTML = "";


    const box =
        document.createElement(
            "div"
        );


    box.className =
        "message-state";


    const title =
        document.createElement(
            "h2"
        );


    title.textContent =
        heading;


    const paragraph =
        document.createElement(
            "p"
        );


    paragraph.textContent =
        text;


    const link =
        document.createElement(
            "a"
        );


    link.href =
        "school-education.html";


    link.textContent =
        "Choose another class →";


    box.appendChild(title);
    box.appendChild(paragraph);
    box.appendChild(link);

    container.appendChild(box);


    document.getElementById(
        "catalogueControls"
    ).hidden = true;


    document.getElementById(
        "catalogueContent"
    ).hidden = true;

}


/* ========================================
   FILTER OPTIONS
======================================== */

function populateFilters(){

    const familySelect =
        document.getElementById(
            "familyFilter"
        );


    const subjectSelect =
        document.getElementById(
            "subjectFilter"
        );


    const families =
        Array.from(
            new Set(
                examBooks
                    .map(function(book){
                        return book.family;
                    })
                    .filter(Boolean)
            )
        );


    families.sort(function(a,b){

        const aIndex =
            orderIndex(
                a,
                FAMILY_ORDER
            );


        const bIndex =
            orderIndex(
                b,
                FAMILY_ORDER
            );


        if(aIndex !== bIndex){

            return aIndex - bIndex;

        }


        return a.localeCompare(b);

    });


    familySelect.innerHTML =
        '<option value="">All Product Families</option>';


    families.forEach(function(family){

        const option =
            document.createElement(
                "option"
            );


        option.value =
            family;


        option.textContent =
            family;


        familySelect.appendChild(
            option
        );

    });


    const subjects =
        Array.from(
            new Set(
                examBooks
                    .map(function(book){
                        return book.subject;
                    })
                    .filter(Boolean)
            )
        );


    subjects.sort(function(a,b){

        const aIndex =
            orderIndex(
                a,
                SUBJECT_ORDER
            );


        const bIndex =
            orderIndex(
                b,
                SUBJECT_ORDER
            );


        if(aIndex !== bIndex){

            return aIndex - bIndex;

        }


        return a.localeCompare(b);

    });


    subjectSelect.innerHTML =
        '<option value="">All Subjects</option>';


    subjects.forEach(function(subject){

        const option =
            document.createElement(
                "option"
            );


        option.value =
            subject;


        option.textContent =
            subject;


        subjectSelect.appendChild(
            option
        );

    });

}


/* ========================================
   FILTER
======================================== */

function getFilteredBooks(){

    const search =
        document
            .getElementById(
                "bookSearch"
            )
            .value
            .trim()
            .toLowerCase();


    const family =
        document
            .getElementById(
                "familyFilter"
            )
            .value;


    const subject =
        document
            .getElementById(
                "subjectFilter"
            )
            .value;


    return examBooks.filter(
        function(book){

            if(
                family &&
                book.family !== family
            ){
                return false;
            }


            if(
                subject &&
                book.subject !== subject
            ){
                return false;
            }


            if(!search){
                return true;
            }


            const haystack = [

                book.title,
                book.series,
                book.family,
                book.subject,
                book.medium,
                book.sku,
                book.isbn

            ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();


            return haystack.includes(
                search
            );

        }
    );

}


/* ========================================
   GROUPING
======================================== */

function groupByFamily(books){

    const map =
        new Map();


    books.forEach(function(book){

        const family =
            book.family ||
            "Other Exam Preparation";


        if(!map.has(family)){

            map.set(
                family,
                []
            );

        }


        map
            .get(family)
            .push(book);

    });


    return Array
        .from(
            map.entries()
        )
        .sort(function(a,b){

            const aIndex =
                orderIndex(
                    a[0],
                    FAMILY_ORDER
                );


            const bIndex =
                orderIndex(
                    b[0],
                    FAMILY_ORDER
                );


            if(aIndex !== bIndex){

                return aIndex - bIndex;

            }


            return a[0]
                .localeCompare(
                    b[0]
                );

        });

}


function groupBySubject(books){

    const map =
        new Map();


    books.forEach(function(book){

        const subject =
            book.subject ||
            "Other";


        if(!map.has(subject)){

            map.set(
                subject,
                []
            );

        }


        map
            .get(subject)
            .push(book);

    });


    return Array
        .from(
            map.entries()
        )
        .sort(function(a,b){

            const aIndex =
                orderIndex(
                    a[0],
                    SUBJECT_ORDER
                );


            const bIndex =
                orderIndex(
                    b[0],
                    SUBJECT_ORDER
                );


            if(aIndex !== bIndex){

                return aIndex - bIndex;

            }


            return a[0]
                .localeCompare(
                    b[0]
                );

        });

}


/* ========================================
   BOOK ROW
======================================== */

function createBookRow(book){

    const row =
        document.createElement(
            "article"
        );


    row.className =
        "exam-book";


    const cover =
        document.createElement(
            "div"
        );


    cover.className =
        "cover-placeholder";


    cover.textContent =
        "BOOK COVER";


    const details =
        document.createElement(
            "div"
        );


    details.className =
        "book-details";


    const heading =
        document.createElement(
            "h5"
        );


    heading.textContent =
        book.title ||
        "Untitled Book";


    const meta =
        document.createElement(
            "div"
        );


    meta.className =
        "book-meta";


    [
        book.medium,

        book.sku
            ? "SKU: " + book.sku
            : "",

        book.isbn
            ? "ISBN: " + book.isbn
            : "",

        Number.isFinite(book.mrp)
            ? "MRP ₹" + book.mrp
            : ""

    ]
    .filter(Boolean)
    .forEach(function(value){

        const span =
            document.createElement(
                "span"
            );


        span.textContent =
            value;


        meta.appendChild(
            span
        );

    });


    details.appendChild(
        heading
    );


    details.appendChild(
        meta
    );


    const button =
        document.createElement(
            "button"
        );


    button.type =
        "button";


    button.className =
        "book-action";


    button.textContent =
        "View Book";


    button.addEventListener(
        "click",
        function(){

            viewBook(book);

        }
    );


    row.appendChild(
        cover
    );


    row.appendChild(
        details
    );


    row.appendChild(
        button
    );


    return row;

}


/* ========================================
   RENDER
======================================== */

function renderBooks(){

    const books =
        getFilteredBooks();


    const container =
        document.getElementById(
            "familyList"
        );


    container.innerHTML = "";


    document.getElementById(
        "resultsCount"
    ).textContent =
        books.length +
        (
            books.length === 1
                ? " book"
                : " books"
        );


    if(books.length === 0){

        const box =
            document.createElement(
                "div"
            );


        box.className =
            "message-state";


        const heading =
            document.createElement(
                "h2"
            );


        heading.textContent =
            "No matching books";


        const paragraph =
            document.createElement(
                "p"
            );


        paragraph.textContent =
            "Try another search term, product family or subject.";


        box.appendChild(
            heading
        );


        box.appendChild(
            paragraph
        );


        container.appendChild(
            box
        );


        return;

    }


    const families =
        groupByFamily(
            books
        );


    families.forEach(function(familyEntry){

        const familyName =
            familyEntry[0];


        const familyBooks =
            familyEntry[1];


        const familySection =
            document.createElement(
                "section"
            );


        familySection.className =
            "family-section";


        const familyHeading =
            document.createElement(
                "div"
            );


        familyHeading.className =
            "family-heading";


        const heading =
            document.createElement(
                "h3"
            );


        heading.textContent =
            familyName;


        const count =
            document.createElement(
                "span"
            );


        count.textContent =
            familyBooks.length +
            (
                familyBooks.length === 1
                    ? " book"
                    : " books"
            );


        familyHeading.appendChild(
            heading
        );


        familyHeading.appendChild(
            count
        );


        familySection.appendChild(
            familyHeading
        );


        const subjects =
            groupBySubject(
                familyBooks
            );


        subjects.forEach(function(subjectEntry){

            const subjectName =
                subjectEntry[0];


            const subjectBooks =
                subjectEntry[1];


            const subjectGroup =
                document.createElement(
                    "section"
                );


            subjectGroup.className =
                "subject-group";


            const subjectHeader =
                document.createElement(
                    "div"
                );


            subjectHeader.className =
                "subject-header";


            const subjectHeading =
                document.createElement(
                    "h4"
                );


            subjectHeading.textContent =
                subjectName;


            const subjectCount =
                document.createElement(
                    "span"
                );


            subjectCount.textContent =
                subjectBooks.length +
                (
                    subjectBooks.length === 1
                        ? " title"
                        : " titles"
                );


            subjectHeader.appendChild(
                subjectHeading
            );


            subjectHeader.appendChild(
                subjectCount
            );


            const bookList =
                document.createElement(
                    "div"
                );


            bookList.className =
                "book-list";


            subjectBooks.forEach(function(book){

                bookList.appendChild(
                    createBookRow(
                        book
                    )
                );

            });


            subjectGroup.appendChild(
                subjectHeader
            );


            subjectGroup.appendChild(
                bookList
            );


            familySection.appendChild(
                subjectGroup
            );

        });


        container.appendChild(
            familySection
        );

    });

}


/* ========================================
   BOOK DETAIL PLACEHOLDER
======================================== */

function viewBook(book){

    /*
        Book-detail page comes later.

        This does NOT touch the existing
        ordering/cart flow.
    */

    alert(
        book.title +
        "\n\nBook details will be added in the next stage."
    );

}


/* ========================================
   INITIALISE
======================================== */

function initialise(){

    const params =
        new URLSearchParams(
            window.location.search
        );


    const classValue =
        params.get(
            "class"
        );


    if(
        !isValidExamClass(
            classValue
        )
    ){

        showMessage(
            "Choose a class",
            "Exam Preparation is available under Classes 5–10. Choose a class to continue."
        );

        return;

    }


    selectedClass =
        Number(
            classValue
        );


    document.title =
        "Class " +
        selectedClass +
        " Exam Preparation | Cambridge Digital Catalogue";


    document.getElementById(
        "pageHeading"
    ).textContent =
        "Class " +
        selectedClass +
        " Exam Preparation";


    document.getElementById(
        "pageDescription"
    ).textContent =
        "Browse Cambridge guides, assessments, workbooks and other exam-preparation publications available for Class " +
        selectedClass +
        ".";


    document.getElementById(
        "backLink"
    ).href =
        "school-education.html?class=" +
        selectedClass;


    const catalogue =
        getCatalogue();


    examBooks =
        catalogue.filter(function(book){

            return (
                Number(book.class) ===
                    selectedClass &&
                book.category ===
                    "exam"
            );

        });


    if(examBooks.length === 0){

        showMessage(
            "Titles will be added",
            "No verified Exam Preparation records have been added for Class " +
            selectedClass +
            " yet."
        );

        return;

    }


    document.getElementById(
        "catalogueControls"
    ).hidden = false;


    document.getElementById(
        "catalogueContent"
    ).hidden = false;


    populateFilters();

    renderBooks();


    document
        .getElementById(
            "bookSearch"
        )
        .addEventListener(
            "input",
            renderBooks
        );


    document
        .getElementById(
            "familyFilter"
        )
        .addEventListener(
            "change",
            renderBooks
        );


    document
        .getElementById(
            "subjectFilter"
        )
        .addEventListener(
            "change",
            renderBooks
        );

}


/* ========================================
   START
======================================== */

document.addEventListener(
    "DOMContentLoaded",
    initialise
);

</script>


</body>

</html>
